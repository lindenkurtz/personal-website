---
import Layout from '../layouts/Layout.astro'
import WakaChart from '../components/WakaChart.astro'
---

<Layout>
    <section id="home" class="flex-col p-10 scroll-mt-36">
        <div class="flex items-center justify-between w-full">
            <div>
                <h1 class="text-5xl font-bold text-primary">
                    Hello, I'm Linden
                </h1>
                <p class="mt-4 text-lg">
                    I'm a student at the University of Colorado Boulder studying Statistics & Data Science and Computer Science.
                </p>
                <a href="/resume.pdf" target="_blank" class="mt-6 inline-block bg-accent text-white px-6 py-2 rounded">
                    My Resume
                </a>
            </div>
            <div class="ml-16 md:ml-32 lg:ml-48">
                <h3>will be image maybe</h3>
            </div>
        </div>
    </section>
    <section id="projects" class="py-20 px-10 mx-auto scroll-mt-16">
        <div class="mb-16">
            <h2 class="text-4xl font-bold text-primary-dark">Projects</h2>
        </div>
        <div class="space-y-24" />
    </section>
    <section id="now" class="py-20 px-10 mx-auto scroll-mt-16">
        <div class="mb-16">
            <h2 class="text-4xl font-bold text-primary-dark">Now</h2>
        </div>
        <WakaChart />
        <div class="space-y-24" />
    </section>
    <h3 class="flex justify-center text-3xl pt-30 pb-60">
        ⚠️ Under Construction ⚠️
    </h3>
</Layout>