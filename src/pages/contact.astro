---
// Contact page: simple list of direct contact methods and profile links.
import Layout from '../layouts/Layout.astro'

const links = [
  {
    label: 'Email',
    value: 'linden.d.kurtz@gmail.com',
    href: 'mailto:linden.d.kurtz@gmail.com',
    external: false,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/lindenkurtz',
    href: 'https://linkedin.com/in/lindenkurtz',
    external: true,
  },
  {
    label: 'GitHub',
    value: 'github.com/lindenkurtz',
    href: 'https://github.com/lindenkurtz',
    external: true,
  },
  {
    label: 'Resume',
    value: 'Download PDF',
    href: '/resume.pdf',
    external: true,
  },
]
---

<Layout>
    <section class="flex-col p-10 scroll-mt-36">
        <h1 class="text-5xl font-bold text-primary">Get in Touch</h1>
        <p class="mt-4 text-lg max-w-120">
            Have a project in mind, a question, or just want to say hi? I'd love to hear from you.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-10">
            <!-- Email -->
            <a
                href={links[0].href}
                class="group flex items-center gap-4 bg-white rounded-xl border border-black/[0.07] p-5 hover:-translate-y-1 hover:shadow-md transition-all duration-200"
            >
                <div class="flex items-center justify-center w-12 h-12 shrink-0 rounded-full bg-base text-primary group-hover:bg-accent group-hover:text-white transition-all duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                        <polyline points="22,6 12,13 2,6" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-[14px] font-semibold text-primary-dark">{links[0].label}</h3>
                    <p class="text-[13px] text-ink">{links[0].value}</p>
                </div>
            </a>

            <!-- LinkedIn -->
            <a
                href={links[1].href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 bg-white rounded-xl border border-black/[0.07] p-5 hover:-translate-y-1 hover:shadow-md transition-all duration-200"
            >
                <div class="flex items-center justify-center w-12 h-12 shrink-0 rounded-full bg-base text-primary group-hover:bg-accent group-hover:text-white transition-all duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-[14px] font-semibold text-primary-dark">{links[1].label}</h3>
                    <p class="text-[13px] text-ink">{links[1].value}</p>
                </div>
            </a>

            <!-- GitHub -->
            <a
                href={links[2].href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 bg-white rounded-xl border border-black/[0.07] p-5 hover:-translate-y-1 hover:shadow-md transition-all duration-200"
            >
                <div class="flex items-center justify-center w-12 h-12 shrink-0 rounded-full bg-base text-primary group-hover:bg-accent group-hover:text-white transition-all duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.089-.745.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.466-1.335-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.225.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-[14px] font-semibold text-primary-dark">{links[2].label}</h3>
                    <p class="text-[13px] text-ink">{links[2].value}</p>
                </div>
            </a>

            <!-- Resume -->
            <a
                href={links[3].href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 bg-white rounded-xl border border-black/[0.07] p-5 hover:-translate-y-1 hover:shadow-md transition-all duration-200"
            >
                <div class="flex items-center justify-center w-12 h-12 shrink-0 rounded-full bg-base text-primary group-hover:bg-accent group-hover:text-white transition-all duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14,2 14,8 20,8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-[14px] font-semibold text-primary-dark">{links[3].label}</h3>
                    <p class="text-[13px] text-ink">{links[3].value}</p>
                </div>
            </a>
        </div>
    </section>
</Layout>
