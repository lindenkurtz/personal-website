---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const projects = await getCollection('projects')
const sorted = projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
---

<Layout>
  <section class="py-20 px-10 max-w-5xl mx-auto">

    <div class="mb-12">
      <a href="/" class="text-[13px] text-accent font-semibold hover:underline">
        ← Back home
      </a>
      <h1 class="text-4xl font-bold text-primary-dark mt-4">All Projects</h1>
      <p class="text-ink mt-2 text-[14px]">{sorted.length} projects</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((project) => (
        <a
          href={`/projects/${project.id}`}
          class="group block bg-white rounded-xl overflow-hidden border border-black/[0.07] hover:-translate-y-1 hover:shadow-md transition-all duration-200"
        >
          <div class="w-full aspect-video overflow-hidden bg-base-dark">
            <img
              src={project.data.thumbnail}
              alt={project.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <div class="p-5 flex flex-col gap-2">
            <h3 class="text-[14px] font-semibold text-primary-dark">{project.data.title}</h3>
            <p class="text-[12px] text-ink leading-relaxed line-clamp-2">{project.data.description}</p>
            <div class="flex flex-wrap gap-1.5 mt-1">
              {project.data.tags.map((tag) => (
                <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-base text-primary border border-primary">
                  {tag}
                </span>
              ))}
            </div>
            <span class="text-[11px] font-semibold text-accent mt-1 group-hover:underline">View Project →</span>
          </div>
        </a>
      ))}
    </div>

  </section>
</Layout>