---
const navLinks = [
  { href: "home", label: "Home" },
  { href: "projects", label: "Projects" },
  { href: "now", label: "Now" },
]
---

<nav class="sticky top-0 z-50 flex items-center justify-between p-6 bg-base/80 backdrop-blur-md border-b border-base-dark">
    <a href="/" class="text-2xl font-bold text-primary-dark">
        Linden <span class="text-primary">Kurtz</span>
    </a>

    <div class="space-x-8 hidden md:flex text-ink">
        {navLinks.map(({ href, label }) => (
            <a
                href={`/#${href}`}
                data-section={href}
                class="nav-section-link hover:text-primary transition-colors"
            >
                {label}
            </a>
        ))}
    </div>

    <a href="/contact" class="bg-accent text-white px-5 py-2 rounded font-medium hover:bg-opacity-90 transition-all">
        Contact
    </a>
</nav>
