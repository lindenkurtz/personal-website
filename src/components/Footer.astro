---
const year = new Date().getFullYear()

const socialLinks = [
  {
    label: 'Email',
    href: 'mailto:linden.d.kurtz@gmail.com',
    external: false,
    icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z|22,6 12,13 2,6',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/lindenkurtz',
    external: true,
    icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.089-.745.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.466-1.335-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.225.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/lindenkurtz',
    external: true,
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
]

---

<footer class="border-t border-base-dark">
    <div class="max-w-5xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-center md:text-left">
            <a href="/" class="text-xl font-bold text-primary-dark">
                Linden <span class="text-primary">Kurtz</span>
            </a>
            <p class="mt-1 text-sm text-ink/60">
                &copy; {year} Linden Kurtz. All rights reserved.
            </p>
        </div>

        <div class="flex items-center gap-4">
            {socialLinks.map(({ label, href, external, icon }) => (
                <a
                    href={href}
                    aria-label={label}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                    class="flex items-center justify-center w-9 h-9 rounded-full bg-base-dark text-primary-dark hover:bg-accent hover:text-white transition-colors"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill={label === 'Email' ? 'none' : 'currentColor'} stroke={label === 'Email' ? 'currentColor' : 'none'} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        {icon.includes('|') ? (
                            icon.split('|').map((path, i) => (
                                i === 0 ? <path d={path} /> : <polyline points={path} />
                            ))
                        ) : (
                            <path d={icon} />
                        )}
                    </svg>
                </a>
            ))}
        </div>
    </div>
</footer>
