<div class="max-w-2xl mx-auto p-6 bg-base-dark rounded-xl border border-primary-dark/20 min-h-[300px]">
    <div class="flex flex-col sm:flex-row gap-8">
        <div class="flex-1">
            <h3 class="text-xl font-bold text-primary mb-4 text-center">Last 7 days</h3>
            <div class="flex justify-center relative h-64 w-full">
                <canvas id="wakaChartWeek"></canvas>
            </div>
        </div>
        <div class="flex-1">
            <h3 class="text-xl font-bold text-primary mb-4 text-center">All time</h3>
            <div class="flex justify-center relative h-64 w-full">
                <canvas id="wakaChartAllTime"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
  import Chart from 'chart.js/auto';

  const LANGUAGE_COLORS: Record<string, string> = {
    // Web
    'javascript':       '#F7DF1E',  // JS yellow (too iconic to change)
    'typescript':       '#006D77',  // deep teal
    'javascriptreact':  '#00B8A9',  // bright teal
    'typescriptreact':  '#4DB8B0',  // mid teal
    'html':             '#FF8A5B',  // coral orange
    'css':              '#7B61FF',  // purple (complements teal)
    'scss':             '#A48BE0',  // lighter purple

    // Systems / General
    'python':           '#FFD0A8',  // peach
    'go':               '#00ADD8',  // go's own blue (works with teal)
    'rust':             '#E07040',  // darker coral
    'c':                '#A9B8C0',  // muted blue-grey
    'c++':              '#6E9DB5',  // steel blue
    'java':             '#E8735A',  // burnt coral
    'kotlin':           '#C45FAE',  // purple-pink

    // Scripting / Config
    'lua':              '#5B8DD9',  // calm blue
    'bash':             '#2D6A4F',  // forest green
    'shell':            '#2D6A4F',
    'json':             '#B5C4C1',  // muted teal-grey
    'yaml':             '#C9B99A',  // warm sand
    'dotenv':           '#C9B99A',  // same as yaml, config-file family
    'toml':             '#D4A96A',  // golden sand
    'markdown':         '#8FA89E',  // grey-teal
    'mdx':              '#6B9E8F',  // muted teal-green

    // Other
    'astro':            '#FF5D01',  // astro's own orange
    'svelte':           '#FF6B35',  // svelte orange (close to accent)
    'vue':              '#42B883',  // vue green
    'sql':              '#006D77',  
    'other':            '#A0A0A0',
  };

  const FALLBACK_COLORS = [
    '#9B8EA8', '#7A9E9F', '#B5927A', '#6B8F71', '#A67C9B',
    '#8BA3A8', '#C4956A', '#7A8FA6', '#A89B7A', '#6B9E8F'
  ];

  function getLanguageColor(name: string, usedFallbacks: Map<string, string>): string {
    const key = name.toLowerCase();
    if (LANGUAGE_COLORS[key]) return LANGUAGE_COLORS[key];
    
    // Return the same fallback color if we've seen this language before
    if (usedFallbacks.has(key)) return usedFallbacks.get(key)!;
    
    // Assign the next unused fallback
    const color = FALLBACK_COLORS[usedFallbacks.size % FALLBACK_COLORS.length];
    usedFallbacks.set(key, color);
    return color;
  }

  async function initCharts() {
    const style = getComputedStyle(document.documentElement);
    const ink = style.getPropertyValue('--color-ink').trim() || '#ffffff';

    try {
        const [weekRes, allTimeRes] = await Promise.all([
            fetch('/api/takatime?range=week'),
            fetch('/api/takatime?range=alltime')
        ]);

        const weekData = await weekRes.json();
        const allTimeData = await allTimeRes.json();

        renderChart('wakaChartWeek', weekData, ink);
        renderChart('wakaChartAllTime', allTimeData, ink);

    } catch (e) {
        console.error("Charts failed to load", e);
    }
  }

  function renderChart(canvasId: string, result: any, ink: string) {
    const canvas = document.getElementById(canvasId) as HTMLCanvasElement | null;
    if (!canvas) return;

    if (!result.data?.languages || result.data.languages.length === 0) {
        const container = canvas.parentElement;
        if (container) {
            container.innerHTML = `
                <div class="flex items-center justify-center h-full w-full">
                    <p class="text-center text-sm text-ink/60 italic">No activity recorded.</p>
                </div>`;
        }
        return;
    }

    const stats = result.data.languages.slice(0, 10);
    const labels = stats.map((l: { name: string }) => l.name);
    const percentages = stats.map((l: { percent: number }) => l.percent);

    const usedFallbacks = new Map<string, string>();
    const colors = stats.map((l: { name: string }) => getLanguageColor(l.name, usedFallbacks));

    new Chart(canvas, {
        type: 'pie',
        data: {
            labels,
            datasets: [{
                data: percentages,
                backgroundColor: colors,  // ← swap this
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: ink,
                        font: { family: 'Outfit', size: 12 }
                    }
                }
            }
        }
    });
  }

  initCharts();
  document.addEventListener('astro:page-load', initCharts);
</script>