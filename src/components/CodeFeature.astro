---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="code-feature">
  <div class="code-feature__header">
    <span class="code-feature__badge">Featured Code</span>
    <h4 class="code-feature__title">{title}</h4>
    <p class="code-feature__description">{description}</p>
  </div>
  <div class="code-feature__body">
    <slot />
  </div>
</div>

<style>
  .code-feature {
    margin: 2.5rem 0;
    border-left: 3px solid var(--color-primary);
    border-radius: 0 0.5rem 0.5rem 0;
    overflow: hidden;
    background-color: var(--color-base-dark);
  }

  .code-feature__header {
    padding: 1.25rem 1.5rem 1rem;
  }

  .code-feature__badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: 0.2rem 0.6rem;
    border-radius: 0.2rem;
    margin-bottom: 0.75rem;
  }

  .code-feature__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .code-feature__description {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-primary-dark);
    margin: 0;
    line-height: 1.6;
  }

  /* Code block slot — overrides default Shiki/Prism pre margins */
  .code-feature__body :global(pre) {
    margin: 0 !important;
    border-radius: 0 !important;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    padding: 1.25rem 1.5rem !important;
    font-size: 0.85rem !important;
    line-height: 1.65 !important;
  }

  /* Ensure the slot fills the width cleanly */
  .code-feature__body :global(pre code) {
    background: transparent !important;
  }
</style>